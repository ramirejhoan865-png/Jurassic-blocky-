local function isPetFusing(petModel: Model, radius: number)
    if not petModel or not petModel:IsA("Model") then
        return false
    end
    local primary = petModel.PrimaryPart or petModel:FindFirstChild("FakeRootPart") or petModel:FindFirstChild("RootPart")
    if not primary then
        return false
    end
    local petPos = primary.Position
    local nearestSpawn
    local nearestDistance = math.huge
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then
        return false
    end
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if podiums then
            for _, podium in ipairs(podiums:GetChildren()) do
                local spawn = podium:FindFirstChild("Base") and podium.Base:FindFirstChild("Spawn")
                if spawn and spawn:IsA("BasePart") then
                    local dist = (spawn.Position - petPos).Magnitude
                    if dist < nearestDistance and dist <= radius then
                        nearestDistance = dist
                        nearestSpawn = spawn
                    end
                end
            end
        end
    end

    if not nearestSpawn then
        return false
    end
    local attachment = nearestSpawn:FindFirstChild("Attachment")
    if attachment then
        local animalOverhead = attachment:FindFirstChild("AnimalOverhead")
        if animalOverhead then
            local stolenLabel = animalOverhead:FindFirstChild("Stolen")
            if stolenLabel and stolenLabel:IsA("TextLabel") and stolenLabel.Text == "FUSING" then
                return true
            end
        end
    end
    return false
end
